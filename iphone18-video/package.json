{
  "name": "iphone18-pro-max-film",
  "private": true,
  "version": "1.0.0",
  "description": "Film produit 3D procédural de 60 s (Remotion + React Three Fiber)",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render Main4K out/film-4k.mp4",
    "render:vertical": "remotion render Vertical out/film-vertical.mp4",
    "render:all": "npm run render && npm run render:vertical",
    "still": "remotion still Main4K out/still.png",
    "verify": "tsx scripts/verify-timeline.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@remotion/cli": "^4.0.545",
    "@remotion/three": "^4.0.545",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.545",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
